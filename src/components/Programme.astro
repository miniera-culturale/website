---
/* The programme itself: the scroller, its rail, and the three scripts that make
 * it behave — everything a route needs except which evening it opens on.
 *
 * A component and not a page, because there are two routes and one programme.
 * `/` opens on the first evening still to come; `/81` opens on the eighty-first
 * and carries its meta, which is the whole reason those addresses exist — a
 * link shared in a chat shows a title and a picture because of the Open Graph
 * tags of that route, not because of its path. Copied into the second page
 * instead of shared, this would be two sources for one screen: exactly what
 * this repository spends its time catching.
 *
 * The full-screen scroll-snap format is the client's requirement and not a
 * design choice to renegotiate — CLAUDE.md rule 1 — so its costs are paid
 * inside the constraint: `prefers-reduced-motion` turns this into an ordinary
 * list, every evening has an address of its own, and the titles are `<h2>`
 * under the one `<h1>` each route carries.
 *
 * Opening on an evening other than the first is the one thing here that no CSS
 * can do: a document opens at the top, and the position of a scrolling
 * container is not something a stylesheet sets. Hence the inline script below —
 * ten lines, no dependency, and a plain degradation if it does not run.
 */
import Modal from './Modal.astro';
import Scene from './Scene.astro';
import Timeline from './Timeline.astro';
import type { Scene as SceneData } from '../lib/programme.ts';

interface Props {
  scenes: SceneData[];
  /** Which evening this route opens on. */
  openIndex: number;
}

const { scenes, openIndex } = Astro.props;
---

  {/* Before the programme and not after it, which is where it was: the rail is
      fixed, so where it stands on screen owes nothing to where it stands here,
      and after the scroller its ticks came after every button of every evening.
      On the archive this is written for that is eighty-odd stops to pass before
      reaching the one control whose whole purpose is not having to. */}
  <Timeline scenes={scenes} current={openIndex} />

  {/* `tabindex="0"` because this box, and not the document, is what scrolls.
      Safari does not make a scrolling container focusable on its own, so
      without it a reader on a keyboard has nothing to press: the document is
      exactly one screen tall and does not move, the skip link lands on <main>
      whose nearest scrolling ancestor is that same document, and the arrows,
      the space bar and Page Down all do nothing until Tab happens to reach a
      link inside a scene. Chrome and Firefox add the stop themselves; this
      says it out loud for the browser this project's floor is written for. */}
  <div class="scroller" data-scroller tabindex="0">
    {
      scenes.map((scene, index) => (
        <Scene scene={scene} open={index === openIndex} eager={index === openIndex} />
      ))
    }
  </div>

  {/* Inline and synchronous, right after the markup it moves: it runs before
      the first paint, so the programme is *drawn* at the right evening instead
      of being drawn at the top and jumping. `is:inline` keeps Astro from
      bundling it into a deferred module, which would put the jump after the
      paint. Inside the layout and not after it: written after `</Base>` it was
      published after `</html>`, which every browser recovers from by moving it
      into the body — a parse error nobody sees and nothing here needs.

      Measured rather than computed from an index: with `content-visibility` the
      heights are the declared intrinsic ones, and asking the element where it
      is gets the same answer without this file knowing how tall a scene is.

      An address that names a scene wins over the opening evening: `/#serata-82`
      is a link somebody was given — the Timeline of PR 8 writes them — and
      jumping away from it would answer a request with somewhere else.

      Without JavaScript nothing here happens: the programme opens on the oldest
      evening and scrolls normally. That is the whole degradation. */}
  <script is:inline>
    (function () {
      var scroller = document.querySelector('[data-scroller]');
      var open = scroller && scroller.querySelector('[data-open]');
      if (!open) return;

      /* `decodeURIComponent` throws on anything that is not valid percent
         encoding — `/#%` is the whole of it — and thrown from here it takes the
         opening jump with it: the route lands at the top of the archive instead
         of on the evening it names, over one stray character in an address
         somebody else typed. Left as it arrived is the honest fallback, since
         an id that needs no decoding is spelt the same either way. */
      var asked = location.hash ? location.hash.slice(1) : '';
      try {
        asked = decodeURIComponent(asked);
      } catch (error) {
        /* Undecoded, and still worth looking up. */
      }
      if (asked && document.getElementById(asked)) return;

      /* Instant, and from PR 20 it has to say so.
         An assignment to `scrollTop` is not a jump: the setter scrolls with the
         behavior «auto», and «auto» means *the computed value of
         `scroll-behavior`* — so once the scroller declares `smooth`, this line
         animates too. Measured at PR 20 in Firefox 154 and in Chromium 148, and
         the way it fails is silent: a smooth scroll does not advance in a hidden
         tab, so `/85` opened in a background tab — a Ctrl+click, an
         open-in-new-tab — arrives at the top of the archive, and the reader
         finds it there when they switch to it.

         So the property is set aside for this one scroll and put straight back.
         Not `behavior: 'instant'`: `behavior` is a WebIDL enum, and a value an
         engine does not know throws a TypeError rather than falling back to the
         property — thrown from here it would take the opening jump with it, on
         exactly the oldest engines this project still supports. */
      var behaviour = scroller.style.scrollBehavior;
      scroller.style.scrollBehavior = 'auto';
      scroller.scrollTop +=
        open.getBoundingClientRect().top - scroller.getBoundingClientRect().top;
      scroller.style.scrollBehavior = behaviour;
    })();
  </script>

  {/* What the «Prenota il posto» button shows lives in the scene it belongs to,
      not here. It was one template for the whole programme while the panel said
      the same thing to every evening; from PR 12 it carries the WhatsApp link,
      and that link names the evening in the message it sends — so there is one
      per evening still to come, written where that evening is. */}
  <Modal />

  {/* What follows the reader: the tick that says where they are, the accent of
      the evening on screen, and the keys that move between evenings.
      Everything here is *informative* — nothing on the page depends on it to
      work. The ticks are links and the browser does the jump; without this
      script the rail simply stops keeping up.

      Inline like the other two, and for the same practical reason as much as
      any: bundled it would be a module, and a module is deferred — a second
      request for fifty lines that have no imports.

      One observer, three answers. Which evening is on screen is the question
      behind `aria-current`, behind the accent and behind which ticks are in the
      window, and asking it once is the difference between one listener and
      three that can disagree. */}
  <script is:inline>
    (function () {
      var scroller = document.querySelector('[data-scroller]');
      var timeline = document.querySelector('[data-timeline]');
      if (!scroller || !timeline || typeof IntersectionObserver !== 'function') return;

      var scenes = [].slice.call(scroller.querySelectorAll('[data-scene]'));
      var ticks = [].slice.call(timeline.querySelectorAll('[data-tick]'));
      if (scenes.length === 0 || scenes.length !== ticks.length) return;

      var span = Number(timeline.getAttribute('data-window')) || 0;

      // Where the build left it, rather than a guess: the opening evening is
      // marked in the markup, and reading it back is what keeps this script
      // from having to know how that was decided.
      var current = 0;
      for (var i = 0; i < ticks.length; i++) {
        if (ticks[i].getAttribute('aria-current')) current = i;
      }

      /* The jumps are animated again from PR 20, and the animation is a
         **property** — never an argument. CLAUDE.md rule 15.

         It was taken away at PR 9 and for a measured reason: a jump the engine
         animates can be interrupted, and a second one issued while the first is
         in flight was dropped, leaving the programme on the first destination
         while the rail, the accent and the address all named the second. It
         came back because the client, on a phone, said that pressing a tick
         produces no movement at all — the site looks as if it had not answered.

         What answers the old measurement is not a promise that engines have
         improved. It is `settle()` below: when the scrolling stops, the landing
         is compared with the destination and put right if they differ. The
         defect no longer has to be prevented, which is what could only be done
         by refusing to move.

         `scrollIntoView()` is still called with no argument at all, and that is
         the half that has not changed: `behavior: 'smooth'` passed by hand beats
         the `scroll-behavior: auto !important` global.css sets under
         `prefers-reduced-motion`, so a reader who asked for less movement would
         get the full animation anyway, with nothing to see in dist/. Declared as
         a property, the one setting those readers have keeps working. */

      /* The bar on a phone scrolls sideways through every evening there is, so
         the current pill has to be brought into sight as the reader moves. The
         rail on a desktop shows the whole archive at once and does not scroll,
         and asks nothing of this: hence the first line, which is the question
         «does this box scroll at all» rather than a guess about screen widths.

         Measured rather than computed, like the opening jump: asking the two
         elements where they are gets the same answer as arithmetic over widths
         and paddings, and goes on getting it when a pill changes size.

         `scrollTo` and not `scrollIntoView()`, which walks up every scrollable
         ancestor and would move the programme itself to show a tick. And with
         no `behavior`, so that the bar's own `scroll-behavior: smooth` decides:
         until PR 20 this was `scrollLeft +=`, which looks instant and is not —
         it scrolls with the behavior «auto», which is the computed value of the
         property. What the bar was missing was never the call, it was the
         property. The call changed anyway, because a form that reads as instant
         while doing whatever a stylesheet says is the sentence that misled the
         plan of this very PR.

         `instantly` for exactly one caller, the first one: putting the bar
         where the build could not is not a movement to be shown, and animated
         it would be half a second of rail sliding at every page load, saying
         nothing. The property is set aside for that one scroll — not
         `behavior: 'instant'`, which throws where an engine does not know it. */
      function reveal(index, instantly) {
        if (timeline.scrollWidth <= timeline.clientWidth) return;

        var bar = timeline.getBoundingClientRect();
        var tick = ticks[index].getBoundingClientRect();
        var left = timeline.scrollLeft + tick.left - bar.left - (bar.width - tick.width) / 2;

        if (!instantly) {
          timeline.scrollTo({ left: left });
          return;
        }

        var behaviour = timeline.style.scrollBehavior;
        timeline.style.scrollBehavior = 'auto';
        timeline.scrollTo({ left: left });
        timeline.style.scrollBehavior = behaviour;
      }

      /* The window of ticks around `centre`, put on or taken off. The value is
         the distance itself, which is what lets the stylesheet decide how much
         of the window a screen this size can hold — the bar on a phone keeps
         three of the eleven the rail shows. */
      function mark(centre, on) {
        var from = Math.max(0, centre - span);
        var to = Math.min(ticks.length - 1, centre + span);
        for (var i = from; i <= to; i++) {
          if (on) ticks[i].setAttribute('data-near', String(Math.abs(i - centre)));
          else ticks[i].removeAttribute('data-near');
        }
      }

      function setCurrent(index) {
        if (index === current) return;
        mark(current, false);
        ticks[current].removeAttribute('aria-current');

        current = index;
        mark(current, true);
        ticks[current].setAttribute('aria-current', 'true');

        // The accent of the whole document, for everything outside a scene. A
        // scene declares its own and wins inside itself, because custom
        // properties inherit from the nearest ancestor that sets them.
        var cycle = scenes[index].getAttribute('data-cycle');
        if (cycle) document.documentElement.setAttribute('data-cycle', cycle);

        /* And the address, so that copying it copies the evening being read.
           Every evening is a route; the ticks stay fragments on purpose, since
           pointing them at `/N` would make each one fetch two hundred kilobytes
           of document to do the work of a scroll.

           `replaceState` and never `pushState`: pushed, the back button would
           need one press for every evening crossed, so leaving the site the way
           one came would take eighty of them. It is the difference of one word,
           and nothing about the page looks wrong when it is the wrong word.

           Only on a change, which is why this sits below the early return
           above: rewriting `/` to `/81` the moment the page opens would hand
           anyone who bookmarks the root an address that ages — in November that
           bookmark still opens the eighty-first, which by then is behind us.
           `/` is the one address that does not age, and it stays until the
           reader moves. */
        reveal(index);

        /* The name of the tab, with the address. Rule 16 asks the address to
           follow the evening on screen and says nothing about the title,
           which is the half a bookmark actually saves: halfway down the
           archive the browser was offering «/78» under the name «Il
           programma». The string is not composed here — the scene carries it
           in `data-title`, written by the same `eveningTitle()` the route
           `/78` titles itself with. */
        var name = scenes[index].getAttribute('data-title');
        if (name) document.title = name;

        /* And the evening the reader is actually on, said in the markup so
           that a stylesheet can ask. `data-open` cannot answer it: the build
           writes it once, on the evening the route opens at, and nothing moves
           it — so print.css was putting the opening evening on paper while the
           reader was looking at another one. With no script running there is
           no `data-current` anywhere and the opening evening is the one on
           screen, which is what the print sheet falls back to. */
        for (var s = 0; s < scenes.length; s++) scenes[s].removeAttribute('data-current');
        scenes[index].setAttribute('data-current', 'true');

        var number = scenes[index].getAttribute('data-number');
        if (number && history.replaceState) {
          try {
            /* The query string travels: somebody arriving from a link with a
               campaign on it keeps it when the address is rewritten, and what
               they copy is still the address they were given. */
            history.replaceState(null, '', '/' + number + location.search);
          } catch (error) {
            /* WebKit refuses more than a hundred history writes in thirty
               seconds and throws when it does — holding an arrow key from the
               first evening to the last and back is enough. Uncaught, that
               throw travels out through `aim()` into the keydown handler, which
               has already called `preventDefault()` and has not scrolled yet:
               the arrows would stop moving the programme at all for the rest of
               that window, with the native scroll suppressed and nothing put in
               its place. The address falling behind is the whole cost of
               reaching the limit, and it is the part nobody is hurt by. */
          }
        }
      }

      /* The design's guard, and from PR 20 it guards something that happens on
         every jump instead of only in a browser we cannot watch.
         A jump the engine animates crosses every evening in between, and the
         observer reports each one: the rail flickering through forty dates and
         the site through forty colours before settling. So a jump names its
         destination, and until that destination arrives — or the scrolling
         stops, or 1200 ms pass, because an animation interrupted by snap may
         never arrive at all — what the observer reports is not news. */
      var target = null;
      var timer;

      function aim(index) {
        /* Already there: nothing is going to cross the middle line, so the
           destination would never arrive and the guard would sit deaf for its
           whole 1200 ms — the rail and the accent frozen while the reader
           scrolls. Clicking the current tick and pressing Down on the last
           evening are both this. */
        if (index === current) return;

        target = index;
        clearTimeout(timer);
        timer = setTimeout(function () {
          target = null;
        }, 1200);
        setCurrent(index);
      }

      /* Where a jump ended up, which from PR 20 is not the same question as
         where it was sent.
         An animated jump can be interrupted, and an interrupted one may be
         dropped: PR 9 measured two ticks tapped two tenths of a second apart
         leaving the programme on the first destination while the rail, the
         accent and the address named the second. Nothing here promises that no
         longer happens — on Firefox 154 it does not, at any human interval, and
         Safari is the engine we do not get to see until the site is published
         (docs/questioni-aperte.md). What this does is make it not matter: when
         the scrolling stops, the landing is compared with the destination and
         put right if they differ.

         Instant, and it says so with the property set aside: a correction that
         animated would be a second jump, interruptible in its turn.

         Two deadlines and not one. A jump that moves keeps pushing the short
         one out with its own scroll events, so the check runs once the movement
         has stopped — the snap's own last adjustment included. A jump that
         never moves at all fires nothing, and the long one is what catches it:
         without it a dropped jump would sit armed until the reader's next
         flick, and *that* would pull them to an evening they had stopped
         asking for. */
      var landing = null;
      var settling;

      function watch(index) {
        landing = index;
        clearTimeout(settling);
        settling = setTimeout(settle, 800);
      }

      /* A reader who has taken the scrolling back into their own hands is not
         still travelling to where a jump was going. */
      function abandon() {
        landing = null;
      }

      function settle() {
        /* The movement is over, whatever it did, so the observer speaks again.
           This is the clause that lets the mute above outlast a long animation
           without having to guess how long one is. */
        target = null;
        clearTimeout(timer);

        var index = landing;
        landing = null;
        if (index === null) return;

        var delta =
          scenes[index].getBoundingClientRect().top - scroller.getBoundingClientRect().top;
        if (Math.abs(delta) < 1) return; // arrived, which is the ordinary case

        var behaviour = scroller.style.scrollBehavior;
        scroller.style.scrollBehavior = 'auto';
        scroller.scrollTop += delta;
        scroller.style.scrollBehavior = behaviour;
      }

      scroller.addEventListener(
        'scroll',
        function () {
          clearTimeout(settling);
          settling = setTimeout(settle, 140);
        },
        { passive: true },
      );

      scroller.addEventListener('pointerdown', abandon, { passive: true });
      scroller.addEventListener('wheel', abandon, { passive: true });

      var observer = new IntersectionObserver(
        function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (!entries[i].isIntersecting) continue;
            var index = scenes.indexOf(entries[i].target);
            if (index === -1) continue;

            if (target !== null) {
              if (index === target) {
                target = null;
                clearTimeout(timer);
              }
              continue;
            }
            setCurrent(index);
          }
        },
        // A line across the middle of the scroller rather than a share of a
        // scene: with the margins taking both halves away the root is one
        // horizontal line, and the evening crossing it is the evening being
        // read — exactly one of them, whatever the height of a scene.
        { root: scroller, rootMargin: '-50% 0px -50% 0px' },
      );

      for (var s = 0; s < scenes.length; s++) observer.observe(scenes[s]);

      /* Where the build could not put it: a scroll position is not something a
         stylesheet sets, so the bar arrives showing the oldest evening while
         `aria-current` sits on one out of sight. This is the first thing that
         puts it right, and with no scripting it is what a reader is left with —
         declared in docs/piano.md rather than papered over. */
      reveal(current, true);

      // The jump itself is the browser's: this only says where it is going, so
      // that the rail does not read the forty evenings it passes over.
      timeline.addEventListener('click', function (event) {
        /* A click the browser is not going to follow — Ctrl or Cmd for a new
           tab, Shift for a new window, anything already handled — leaves the
           programme exactly where it was. Aiming at the evening it names would
           move `aria-current`, the accent and the window onto an evening that
           is not on screen, and then deafen the observer for 1200 ms, so
           nothing would put them back until the reader scrolled. */
        if (event.defaultPrevented || event.button !== 0) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

        var tick = event.target.closest ? event.target.closest('[data-tick]') : null;
        if (!tick) return;

        var index = Number(tick.getAttribute('data-index'));
        if (index < 0 || index >= scenes.length) return;

        /* The jump is ours from here on, and that is the whole point: left to
           the browser, a click on `#serata-78` pushes a history entry — the
           browser does it, not us — and the observer then rewrites that entry
           to `/78`. What a reader gets is a back button that changes the
           address and leaves the page where it is; the second press leaves the
           site. Rule 16 promises the back button gets you out, and the promise
           covered the scrolling and not the jumps. Found at PR 18, fixed here.

           The clicks a browser would not follow — middle, Ctrl, Cmd, Shift —
           have already returned above: that is half the reason a tick is an
           anchor, and preventing those would be taking it back.

           `scrollIntoView()` with no argument at all, rule 15: the how is left
           to `scroll-behavior`, which is what animates this for everybody and
           leaves it instant for whoever asked for reduced motion. And `watch()`
           after it, because from PR 20 the jump moves and a moving jump can be
           interrupted: what makes that survivable is checking where it landed,
           not hoping it lands. */
        event.preventDefault();
        aim(index);
        scenes[index].scrollIntoView();
        watch(index);

        /* And the focus, which the browser would have moved itself: following
           an anchor sets the point the next Tab starts from, and preventing
           the default took that away — a keyboard pressing Enter on a tick
           landed on the evening and went on tabbing through the rail. The
           scene takes `tabindex="-1"` for this and stays out of the tab order.
           `preventScroll` because the scrolling is already done, and asking
           for it twice is how a jump ends up somewhere else. */
        scenes[index].focus({ preventScroll: true });
      });

      /* The wheel over the rail, which was doing nothing at all.
         The column is `pointer-events: none` so that scrolling passes through
         it, and the ticks put it back to `auto` so they stay clickable — and a
         tick, having caught the wheel, looks for a scrolling ancestor of its
         own: the rail does not scroll down here, and the document is one screen
         tall. So the programme stood still wherever the pointer happened to be
         over a date. Measured on Firefox 153 at PR 19, and true in every engine
         — it is the trap the rail's own comment describes for the column,
         never closed for the ticks themselves.

         There is no CSS for «take clicks but not the wheel», so the event is
         handed on by hand. Not passive, because preventing the default is the
         point: without it the page underneath scrolls twice. */
      var lastWheel = 0;

      timeline.addEventListener(
        'wheel',
        function (event) {
          if (event.ctrlKey) return; // pinch zoom, which belongs to the browser
          if (timeline.scrollWidth > timeline.clientWidth) return; // the phone's bar scrolls itself

          event.preventDefault();

          /* One evening per gesture, the same move the arrow keys make — and
             not `scrollTop += deltaY`, which was the first attempt and does
             not survive the snap: with `scroll-snap-type: y mandatory` a
             scroll of two hundred pixels inside a scene eight hundred tall is
             pulled straight back to where it started, so the rail stayed dead
             while looking fixed.

             A trackpad sends a burst of these, so a gesture is one jump: the
             gate is time and not distance, because the number of events in a
             flick is a property of the device and its duration is not. */
          /* The gate closes on the whole burst and not on its first event: a
             trackpad sends one every sixteen milliseconds for as long as the
             hand moves, so comparing against the last *jump* let one through
             every 220 ms — nine evenings in two seconds, while the comment
             promised one per gesture. Compared against the last *event*, a
             gesture is one jump however long it lasts, and the next one needs
             a pause to start. */
          var inTheSameGesture = event.timeStamp - lastWheel < 220;
          lastWheel = event.timeStamp;
          if (inTheSameGesture) return;

          var next = current + (event.deltaY > 0 ? 1 : -1);
          if (next < 0 || next >= scenes.length) return;
          aim(next);
          scenes[next].scrollIntoView();
          watch(next);
        },
        { passive: false },
      );

      /* The keys, explicitly, on the box that scrolls.
         A scrolling container answers the arrows by itself in Chrome and
         Firefox, by a number of pixels and not by an evening; Safari does not
         answer at all until something inside it has focus. Both are the same
         problem for a reader on a keyboard, and docs/vincoli-tecnici.md asks
         for these five keys by name.

         `scrollIntoView()` with no argument at all: that leaves the *how* to
         `scroll-behavior`, which is the only way a reader who has asked for
         reduced motion gets an instant jump. */
      scroller.addEventListener('keydown', function (event) {
        // Shift with the rest: Shift+Home and Shift+Down are how a keyboard
        // selects, and taking them over answers a request nobody made.
        if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;

        /* Every other key that scrolls is the browser's — Space, Tab onto
           something below the fold — and it is the reader scrolling, so a jump
           still in flight stops being theirs. */
        abandon();

        var index = null;
        if (event.key === 'Home') index = 0;
        else if (event.key === 'End') index = scenes.length - 1;
        else if (event.key === 'ArrowDown' || event.key === 'PageDown') index = current + 1;
        else if (event.key === 'ArrowUp' || event.key === 'PageUp') index = current - 1;
        if (index === null) return;

        index = Math.max(0, Math.min(scenes.length - 1, index));
        event.preventDefault();
        aim(index);
        scenes[index].scrollIntoView();
        watch(index);
      });
    })();
  </script>

<style>
  /* The scroller is the page: the document itself does not scroll, this does.
     One screen per evening, snapping to the top of each.

     `--scene-height` is `svh` with a `vh` fallback declared in @supports — with
     `dvh` the height changes as Safari's address bar retracts and, under
     mandatory snap, the position jumps (rule 5). */
  .scroller {
    height: var(--scene-height);
    overflow-y: auto;
    scroll-snap-type: y mandatory;

    /* The jumps move, from PR 20, and they move because of this line and not
       because of an argument somewhere in the script — rule 15. Declared here,
       `prefers-reduced-motion` can take it away, and global.css does, with
       `scroll-behavior: auto !important`.

       It reaches more than the three `scrollIntoView()` calls: every scroll a
       script asks for on this box, an assignment to `scrollTop` included. The
       two that must stay instant — the opening jump and the landing check — set
       this aside for themselves, and say why. */
    scroll-behavior: smooth;

    /* Hidden, as in the design: the Timeline of PR 8 is what tells a reader
       where they are, and a scrollbar over 81 evenings says almost nothing. */
    scrollbar-width: none;
  }

  .scroller::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

</style>
